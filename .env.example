# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8000

# MySQL 8.0
DB_HOST=127.0.0.1
# Host port 3307 — 3306 is taken by another local MySQL on this machine
DB_PORT=3307
DB_NAME=babymart
DB_USER=babymart
DB_PASSWORD=

# Redis
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=60

# Auth — must be at least 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origins (CORS allow-list)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Cloudflare R2 (S3-compatible object storage)
# Account id is the hex prefix of the bucket's S3 API endpoint.
CLOUDFLARE_ACCOUNT_ID=
# Optional. Paste the S3 API endpoint from the dashboard, or leave blank to
# derive it from CLOUDFLARE_ACCOUNT_ID.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=babymart-media
# Where the browser READS objects: a custom domain, or the bucket's
# https://pub-<id>.r2.dev development URL. Not the signed S3 endpoint.
R2_PUBLIC_BASE_URL=https://media.example.com

# Payments — 'mock' until a real gateway is wired in.
# 'mock' is rejected at boot when NODE_ENV=production.
PAYMENT_PROVIDER=mock
# Required only when PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
